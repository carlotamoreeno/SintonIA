# Aplicacion
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ACTIVE_DATASET_VERSION=mvp-2026-03

# Auth
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_EXPERT_EMAILS=
AUTH_ADMIN_EMAILS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# Congelado MVP T-62: compatibilidad operativa; el chat resuelve desde knowledge_vector_store_registry.
OPENAI_ACTIVE_VECTOR_STORE_ID=vs_69ca9b4e5e2081919bec55eb91742f70
OPENAI_TIMEOUT_MS=30000
OPENAI_VECTOR_STORE_FILE_CHUNKING_STRATEGY=auto
# Solo cuando OPENAI_VECTOR_STORE_FILE_CHUNKING_STRATEGY=static
# OPENAI_VECTOR_STORE_FILE_MAX_CHUNK_SIZE_TOKENS=800
# OPENAI_VECTOR_STORE_FILE_CHUNK_OVERLAP_TOKENS=400

# Runtime caps (pueden reducirse por entorno, pero no superar los topes del MVP)
CHAT_ENABLE_PROMPT_CACHING=false
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_TURNS=12
CHAT_MAX_OUTPUT_TOKENS=4096
CHAT_RATE_LIMIT_PER_MIN=20
